<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>

<style>
  /* Force navbar links to use your theme colors, overriding Bootstrap */
  .navbar a.nav-link {
    color: #fff !important; /* Forces white text */
    font-size: 14px; /* Matches your theme size */
    font-weight: 600;
  }
  .navbar a.nav-link:hover,
  .navbar a.nav-link.active {
    color: #fbbf24 !important; /* Forces yellow on hover/active */
  }
  /* Fix global link decorations that Bootstrap adds */
  a {
    text-decoration: none;
  }
</style>

<div
  class="container d-flex justify-content-center align-items-center"
  style="min-height: 70vh"
>
  <div
    class="card shadow"
    style="
      width: 100%;
      max-width: 400px;
      border-radius: 10px;
      border-top: 5px solid #fbbf24;
    "
  >
    <div class="card-body p-4">
      <h2 class="text-center fw-bold mb-2">Welcome Back</h2>
      <p class="text-center text-muted mb-4">Login to your account</p>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label fw-bold">Email Address</label>
          <input
            type="email"
            name="email"
            class="form-control form-control-lg"
            placeholder="admin@gmail.com"
            required
          />
        </div>
        <div class="mb-4">
          <label class="form-label fw-bold">Password</label>
          <input
            type="password"
            name="password"
            class="form-control form-control-lg"
            placeholder="••••••••"
            required
          />
        </div>
        <button
          type="submit"
          class="btn btn-warning w-100 fw-bold py-2 text-dark"
        >
          LOGIN
        </button>
      </form>

      <div class="text-center mt-4">
        <p class="small text-muted">
          Don't have an account?
          <a href="/register" class="text-warning fw-bold text-decoration-none"
            >Register here</a
          >
        </p>
      </div>
    </div>
  </div>
</div>
