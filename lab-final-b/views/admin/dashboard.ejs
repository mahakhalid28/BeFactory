<div class="admin-header">
  <h1>Product Dashboard</h1>
  <a href="/admin/products/add" class="btn-yellow"> + Add New Product</a>
</div>

<table>
  <thead>
    <tr>
      <th>Image</th>
      <th>Name</th>
      <th>Category</th>
      <th>Price</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(function(product) { %>
    <tr>
      <td><img src="/images/<%= product.image %>" height="40" /></td>
      <td><%= product.name %></td>
      <td><%= product.category %></td>
      <td>$<%= product.price %></td>
      <td>
        <a
          href="/admin/products/edit/<%= product._id %>"
          class="btn-sm btn-edit"
          >Edit</a
        >
        <a
          href="/admin/products/delete/<%= product._id %>"
          class="btn-sm btn-danger"
          onclick="return confirm('Are you sure?')"
          >Delete</a
        >
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
