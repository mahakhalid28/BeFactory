<%- include('partials/navbar') %>

<div class="container" style="margin-top: 50px; min-height: 80vh">
  <div class="text-center mb-5">
    <h1
      class="fw-bold text-uppercase"
      style="color: #fbbf24; letter-spacing: 2px"
    >
      Order Preview
    </h1>
    <p class="text-muted">Please review your items before confirming.</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div
        class="card shadow-lg mb-4"
        style="background-color: #212529; border: 1px solid #444"
      >
        <div
          class="card-header py-3"
          style="background-color: #1a1d20; border-bottom: 1px solid #444"
        >
          <h5 class="m-0 text-white">📦 Items in Your Cart</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table
              class="table table-dark table-striped table-hover m-0 align-middle"
            >
              <thead style="border-bottom: 2px solid #fbbf24">
                <tr>
                  <th class="ps-4" style="color: #fbbf24">Product</th>
                  <th style="color: #fbbf24">Price</th>
                  <th style="color: #fbbf24">Qty</th>
                  <th class="pe-4 text-end" style="color: #fbbf24">Subtotal</th>
                </tr>
              </thead>
              <tbody>
                <% for(let id in cart) { %>
                <tr>
                  <td class="ps-4 fw-bold"><%= cart[id].item.name %></td>
                  <td>$<%= cart[id].item.price %></td>
                  <td><%= cart[id].quantity %></td>
                  <td class="pe-4 text-end fw-bold text-warning">
                    $<%= cart[id].item.price * cart[id].quantity %>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div
        class="card shadow-lg"
        style="background-color: #212529; border: 1px solid #fbbf24"
      >
        <div
          class="card-header text-center py-3"
          style="background-color: #fbbf24"
        >
          <h5 class="m-0 fw-bold text-dark text-uppercase">💰 Bill Summary</h5>
        </div>

        <div class="card-body p-4 text-white">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Original Total:</span>
            <span class="fw-bold"
              >$<%= (Number(finalTotal) + Number(discount)) %></span
            >
          </div>

          <% if(discount > 0) { %>
          <div class="d-flex justify-content-between mb-2 text-success">
            <span>Discount Applied:</span>
            <span>- $<%= discount %></span>
          </div>
          <small class="d-block mb-3 text-end fst-italic text-muted">
            (Coupon 'SAVE10' Applied)
          </small>
          <% } else { %>
          <div class="d-flex justify-content-between mb-3 text-muted">
            <span>Discount:</span>
            <span>$0.00</span>
          </div>
          <% } %>

          <hr style="border-color: #777" />

          <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="h5 m-0">Grand Total:</span>
            <span class="h2 m-0 fw-bold" style="color: #fbbf24"
              >$<%= finalTotal %></span
            >
          </div>

          <form action="/order/confirm" method="POST">
            <input
              type="hidden"
              name="customerName"
              value="<%= customerName %>"
            />
            <input type="hidden" name="email" value="<%= email %>" />

            <button
              type="submit"
              class="btn w-100 btn-lg fw-bold mb-3 shadow-sm"
              style="background-color: #fbbf24; color: #000"
            >
              Confirm Order ✓
            </button>
          </form>

          <a href="/buynow" class="btn btn-outline-light w-100 btn-sm">
            ← Go Back to Edit
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
