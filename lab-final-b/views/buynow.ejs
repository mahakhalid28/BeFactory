<%- include('partials/navbar') %>

<div class="container" style="margin-top: 50px; min-height: 80vh">
  <h1
    class="mb-4"
    style="color: #fbbf24; font-weight: bold; text-transform: uppercase"
  >
    <span style="border-bottom: 3px solid #fbbf24">Checkout</span>
  </h1>

  <% if (!cart || Object.keys(cart).length === 0) { %>
  <div class="alert alert-dark p-5 text-center shadow">
    <h3>Your cart is empty.</h3>
    <a href="/products" class="btn btn-warning mt-3 fw-bold">Go shopping!</a>
  </div>
  <% } else { %>

  <div class="row g-5">
    <div class="col-md-7">
      <div class="table-responsive">
        <table
          class="table table-dark table-striped table-hover align-middle shadow-sm"
          style="border: 1px solid #444"
        >
          <thead>
            <tr style="border-bottom: 2px solid #fbbf24">
              <th style="color: #fbbf24">Product</th>
              <th style="color: #fbbf24">Price</th>
              <th style="color: #fbbf24">Qty</th>
              <th style="color: #fbbf24">Total</th>
            </tr>
          </thead>
          <tbody>
            <% var totalBill = 0; %> <% for (let id in cart) { %> <% let item =
            cart[id].item; %> <% let qty = cart[id].quantity; %> <% let rowTotal
            = item.price * qty; %> <% totalBill += rowTotal; %>

            <tr>
              <td>
                <span class="fw-bold"><%= item.name %></span>
              </td>
              <td>$<%= item.price %></td>
              <td><%= qty %></td>
              <td class="fw-bold text-warning">$<%= rowTotal %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col-md-5">
      <div
        class="card shadow-lg"
        style="
          background-color: #212529;
          border: 1px solid #fbbf24;
          border-radius: 10px;
        "
      >
        <div
          class="card-header text-center py-3"
          style="
            background-color: #1a1d20;
            border-bottom: 1px solid #444;
            border-radius: 10px 10px 0 0;
          "
        >
          <h4 style="color: #fbbf24; margin: 0">ORDER SUMMARY</h4>
        </div>

        <div class="card-body p-4">
          <h6 class="text-light text-uppercase ls-1">Grand Total</h6>
          <h1 class="display-4 fw-bold mb-4" style="color: #fbbf24">
            $<%= totalBill %>
          </h1>

          <hr style="border-color: #555" />

          <form action="/order/preview" method="POST">
            <div class="mb-3">
              <label class="form-label text-light fw-bold">Full Name</label>
              <input
                type="text"
                name="customerName"
                class="form-control form-control-lg"
                style="
                  background: #fff !important;
                  color: #000 !important;
                  border: none;
                "
                placeholder="e.g. Ali Khan"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label text-light fw-bold">Email Address</label>
              <input
                type="email"
                name="email"
                class="form-control form-control-lg"
                style="
                  background: #fff !important;
                  color: #000 !important;
                  border: none;
                "
                placeholder="name@example.com"
                required
              />
            </div>

            <div class="mb-4">
              <label class="form-label text-light fw-bold">Coupon Code</label>
              <div class="input-group">
                <input
                  type="text"
                  name="coupon"
                  class="form-control form-control-lg"
                  style="
                    background: #fff !important;
                    color: #000 !important;
                    border: none;
                  "
                  placeholder="Enter code here"
                />
                <span
                  class="input-group-text fw-bold"
                  style="background-color: #fbbf24; border: none; color: #000"
                  >SAVE10</span
                >
              </div>
            </div>

            <button
              type="submit"
              class="btn w-100 btn-lg fw-bold shadow-sm"
              style="background-color: #fbbf24; color: #000; font-size: 1.2rem"
            >
              Proceed to Preview ➡
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <% } %>
</div>

<%- include('partials/footer') %>
