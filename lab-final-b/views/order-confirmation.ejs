<%- include('partials/navbar') %>

<div
  class="container text-center"
  style="margin-top: 100px; margin-bottom: 100px"
>
  <div style="font-size: 80px; color: #198754">✓</div>

  <h1 class="display-4 text-success fw-bold">Order Confirmed!</h1>

  <p class="lead mt-3">
    Thank you for your purchase, <strong><%= order.customerName %></strong>.
  </p>

  <div
    class="card p-4 mx-auto mt-4 bg-light shadow-sm"
    style="max-width: 500px"
  >
    <p class="mb-1">Your Order ID is:</p>
    <h5 class="fw-bold text-primary"><%= order._id %></h5>

    <hr />

    <div class="d-flex justify-content-between">
      <span>Total Amount Paid:</span>
      <strong class="text-success">$<%= order.totalAmount %></strong>
    </div>

    <div class="d-flex justify-content-between mt-2">
      <span>Status:</span>
      <span class="badge bg-primary"><%= order.status %></span>
    </div>
  </div>

  <div class="mt-5">
    <a href="/products" class="btn btn-outline-dark btn-lg"
      >Continue Shopping</a
    >
    <a href="/my-orders" class="btn btn-primary btn-lg ms-2">View My Orders</a>
  </div>
</div>

<%- include('partials/footer') %>
